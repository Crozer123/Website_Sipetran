                            >
                                <i
                                    class="fa-solid fa-building-columns text-emerald-700"
                                ></i> Kemendikbudristek
                            </div>
                            <div
                                class="text-xs font-bold text-gray-800 flex items-center gap-2"
                            >
                                <i
                                    class="fa-solid fa-graduation-cap text-emerald-700"
                                ></i> Perguruan Tinggi
                            </div>
                            <div
                                class="text-xs font-bold text-gray-800 flex items-center gap-2"
                            >
                                <i class="fa-solid fa-users text-teal-700"></i> Tim
                                PPK Ormawa
                            </div>
                            <div
                                class="text-xs font-bold text-gray-800 flex items-center gap-2"
                            >
                                <i class="fa-solid fa-tree-city text-green-700"
                                ></i> Pemdes Gunungsari
                            </div>
                        </div>
                    </div>
                    <a
                        href="/modul"
                        @click="mobileOpen=false"
                        class="py-3 border-b border-gray-100 text-sm text-gray-700 font-medium"
                        >Program Modul</a
                    >
                    <a
                        href="/kegiatan"
                        @click="mobileOpen=false"
                        class="py-3 text-sm font-medium hover:text-sipetran-green"
                        >Kegiatan</a
                    >
                </div>
            </div>
        </header>

        <!-- ============ HERO SECTION (PPK Ormawa Photo Background) ============ -->
        <section
