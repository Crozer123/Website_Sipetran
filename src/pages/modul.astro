        kegiatan: [
            {
                num: 1,
                judul: 'Koordinasi Lanjutan Program Lingkungan dengan Pemerintah Desa',
                deskripsi: 'Koordinasi lanjutan terkait program lingkungan SIPETRAN termasuk rencana pemasangan incinerator drum di titik-titik strategis Desa Gunungsari bersama perangkat desa.',
