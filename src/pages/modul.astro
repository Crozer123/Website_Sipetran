            {
                num: 4,
                judul: 'Pembuatan Formulasi Nugget SIJAGO',
                deskripsi: 'Proses uji coba dan pembuatan formulasi nugget berbahan dasar Jagung, Singkong, dan Kelor (SIJAGO) bersama warga Desa Gunungsari sebagai produk pangan bergizi pencegah stunting.',
                icon: 'fa-mortar-pestle',
                driveLink: 'https://drive.google.com/drive/folders/17bF6vdEX947vZnX1-RvoEvrIcKg2LPJI'
