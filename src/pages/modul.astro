        kegiatan: [
            {
                num: 3,
                judul: 'Sosialisasi Program Kesehatan kepada Kelompok Sasaran',
                deskripsi: 'Sosialisasi program SIPETRAN bidang kesehatan bersama perangkat desa dan kelompok divisi sasaran, termasuk demonstrasi 6 langkah cuci tangan standar WHO dan cara pembuatan oralit darurat.',
