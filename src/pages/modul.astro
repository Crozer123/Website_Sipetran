                            </div>
                        </div>
                    );
                })}
            </div>
        </div>
    </section>

    <!-- ============ POPUP MODAL SMARTPHONE READER ============ -->
    <div x-show="activeModalModul" x-transition.opacity
        class="fixed inset-0 z-[100] modal-backdrop flex items-center justify-center p-2 sm:p-4"
        @click.self="closeReader()"
        @keydown.escape.window="closeReader()"
        style="display:none;">

        <!-- Outer Smartphone Frame Container -->
        <div class="relative w-full transition-all duration-300 flex items-center justify-center"
            :class="isFullscreen ? 'max-w-4xl h-[95vh]' : 'max-w-[420px] sm:max-w-[460px] h-[92vh] max-h-[850px]'">

            <!-- Mobile Phone Shell Frame -->
            <div class="bg-gray-950 rounded-[3rem] p-3 sm:p-4 shadow-[0_25px_60px_-15px_rgba(0,0,0,0.7)] border-4 border-stone-700/50 w-full h-full flex flex-col relative overflow-hidden ring-1 ring-white/10">

                <!-- Dynamic Island / Phone Speaker Notch -->
                <div class="absolute top-4 left-1/2 -translate-x-1/2 z-30 flex items-center gap-2 bg-black px-4 py-1 rounded-full border border-stone-800 shadow-inner pointer-events-none">
                    <div class="w-2.5 h-2.5 rounded-full bg-stone-900 border border-stone-700"></div>
                    <div class="w-12 h-1.5 rounded-full bg-stone-900"></div>
                </div>

                <!-- Inner Smartphone Screen -->
                <div class="bg-[#FAF8F2] w-full h-full rounded-[2.2rem] flex flex-col overflow-hidden relative border border-stone-200 shadow-inner">

                    <!-- 1. Status Bar -->
                    <div class="bg-sipetran-dark text-stone-300 px-6 pt-3 pb-1 flex justify-between items-center text-[11px] font-semibold tracking-wider shrink-0 z-20">
                        <span x-text="new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})">09:41</span>
                        <div class="flex items-center gap-2 text-stone-300 text-[10px]">
                            <i class="fa-solid fa-wifi"></i>
                            <span class="font-bold text-[9px] bg-emerald-600 text-white px-1 rounded">5G</span>
                            <i class="fa-solid fa-battery-full text-xs text-emerald-400"></i>
                        </div>
                    </div>

                    <!-- 2. Top App Bar Header -->
                    <div class="bg-sipetran-green text-white px-4 py-3 flex items-center justify-between shrink-0 shadow-md z-20">
                        <div class="flex items-center gap-2.5 min-w-0">
                            <button @click="closeReader()" class="w-8 h-8 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center text-white transition-colors shrink-0" title="Kembali">
                                <i class="fa-solid fa-arrow-left text-xs"></i>
                            </button>
                            <div class="min-w-0">
                                <div class="flex items-center gap-1.5">
                                    <span class="font-handwriting text-lg text-emerald-300 font-bold leading-none">SIPETRAN</span>
                                    <span class="text-[9px] bg-emerald-500/30 text-emerald-200 px-1.5 py-0.5 rounded font-mono uppercase">Modul</span>
                                </div>
                                <h4 class="text-xs font-bold text-white truncate max-w-[170px] sm:max-w-[220px]" x-text="activeModalModul ? activeModalModul.title : ''"></h4>
                            </div>
                        </div>
                        <div class="flex items-center gap-1.5">
                            <button @click="isFullscreen = !isFullscreen" title="Ubah Ukuran Layar" class="w-7 h-7 rounded-lg bg-white/10 hover:bg-white/20 flex items-center justify-center text-stone-200 transition-colors text-xs">
                                <i class="fa-solid" :class="isFullscreen ? 'fa-compress' : 'fa-expand'"></i>
                            </button>
                            <button @click="closeReader()" title="Tutup Modul" class="w-7 h-7 rounded-lg bg-red-500/20 hover:bg-red-500/40 text-red-200 flex items-center justify-center transition-colors text-xs">
                                <i class="fa-solid fa-xmark"></i>
                            </button>
                        </div>
                    </div>

                    <!-- 3. Sub-Modul Horizontal Pill Selector Bar -->
                    <template x-if="activeModalModul && activeModalModul.submodul && activeModalModul.submodul.length > 0">
                        <div class="bg-stone-100 border-b border-stone-200 p-2 shrink-0 z-10 overflow-x-auto scrollbar-none flex gap-1.5">
                            <template x-for="(sub, sIdx) in activeModalModul.submodul" :key="sIdx">
                                <button @click="activeSubIdx = sIdx"
                                    class="px-3 py-1.5 rounded-xl text-xs font-bold whitespace-nowrap transition-all flex items-center gap-1.5 shrink-0"
                                    :class="activeSubIdx === sIdx ? 'bg-sipetran-green text-white shadow-sm scale-[1.02]' : 'bg-white text-stone-600 border border-stone-200 hover:bg-stone-50'">
                                    <i class="fa-solid text-[10px]" :class="sub.icon || 'fa-book-bookmark'"></i>
                                    <span x-text="'Sub ' + (sIdx + 1)"></span>
                                </button>
                            </template>
                        </div>
                    </template>

                    <!-- 4. Scrollable Content Body -->
                    <div class="flex-1 overflow-y-auto p-4 space-y-4 text-stone-800 bg-[#FAF8F2]">

                        <!-- SUB-MODUL READER -->
                        <template x-if="activeModalModul && activeModalModul.submodul && activeModalModul.submodul[activeSubIdx]">
                            <div class="space-y-4 pb-2">

                                <!-- Sub-modul Header Card -->
                                <div class="bg-gradient-to-r from-sipetran-green via-emerald-800 to-sipetran-dark text-white p-4 rounded-2xl shadow-sm relative overflow-hidden">
                                    <div class="absolute -right-4 -bottom-4 opacity-10 text-white text-7xl">
                                        <i class="fa-solid" :class="activeModalModul.submodul[activeSubIdx].icon"></i>
                                    </div>
                                    <div class="relative z-10 space-y-1">
                                        <div class="flex items-center gap-2">
                                            <span class="bg-emerald-400/20 text-emerald-300 border border-emerald-400/30 text-[9px] font-extrabold uppercase px-2 py-0.5 rounded-full"
                                                x-text="'Sub-Modul ' + (activeSubIdx + 1) + ' dari ' + activeModalModul.submodul.length"></span>
                                        </div>
                                        <h3 class="font-display font-black text-lg text-white leading-tight" x-text="activeModalModul.submodul[activeSubIdx].judul"></h3>
                                        <p class="text-xs text-emerald-100/90 leading-relaxed" x-text="activeModalModul.submodul[activeSubIdx].ringkasan"></p>
                                    </div>
                                </div>

                                <!-- Submodul Media Banner Image -->
                                <template x-if="activeModalModul.submodul[activeSubIdx].gambar">
                                    <div class="rounded-2xl overflow-hidden shadow-sm border border-stone-200 bg-stone-900 max-h-[210px] relative group">
                                        <img :src="activeModalModul.submodul[activeSubIdx].gambar" :alt="activeModalModul.submodul[activeSubIdx].judul" class="w-full h-full object-cover">
                                        <div class="absolute bottom-2 right-2 bg-black/60 backdrop-blur-sm text-white text-[9px] px-2 py-0.5 rounded-lg flex items-center gap-1 font-mono">
                                            <i class="fa-solid fa-image text-emerald-400"></i> Panduan Visual
                                        </div>
                                    </div>
                                </template>

                                <!-- Material Section / Points List -->
                                <div class="bg-white rounded-2xl p-4 shadow-sm border border-stone-200 space-y-3">
                                    <div class="flex items-center justify-between border-b border-stone-100 pb-2">
                                        <h4 class="text-xs font-black uppercase tracking-wider text-sipetran-green flex items-center gap-2">
                                            <i class="fa-solid fa-list-check text-emerald-600"></i> Materi & Panduan Pelaksanaan
                                        </h4>
                                        <span class="text-[10px] text-stone-400 font-mono" x-text="activeModalModul.submodul[activeSubIdx].poinMateri.length + ' Poin'"></span>
                                    </div>

                                    <div class="space-y-2.5">
                                        <template x-for="(pt, pIdx) in activeModalModul.submodul[activeSubIdx].poinMateri" :key="pIdx">
                                            <div class="bg-stone-50 hover:bg-emerald-50/50 p-3 rounded-xl border border-stone-200/80 transition-colors flex items-start gap-3">
                                                <div class="w-6 h-6 rounded-lg bg-sipetran-green text-white text-[11px] font-black flex items-center justify-center shrink-0 mt-0.5 shadow-sm"
                                                    x-text="pIdx + 1"></div>
                                                <div class="space-y-0.5 flex-1 min-w-0">
                                                    <h5 class="text-xs font-bold text-stone-900" x-text="pt.judul"></h5>
                                                    <p class="text-xs text-stone-600 leading-relaxed" x-text="pt.desc"></p>
                                                </div>
                                            </div>
                                        </template>
                                    </div>
                                </div>

                                <!-- Next / Previous Sub-modul Navigation Buttons -->
                                <div class="flex items-center justify-between pt-2">
                                    <button @click="activeSubIdx = Math.max(0, activeSubIdx - 1)"
                                        :disabled="activeSubIdx === 0"
                                        class="px-3.5 py-2 rounded-xl text-xs font-bold transition-all flex items-center gap-1.5"
                                        :class="activeSubIdx === 0 ? 'bg-stone-100 text-stone-300 cursor-not-allowed' : 'bg-white text-stone-700 border border-stone-200 hover:bg-stone-100 shadow-sm'">
                                        <i class="fa-solid fa-chevron-left text-[10px]"></i>
                                        <span>Sebelumnya</span>
                                    </button>

                                    <span class="text-[11px] font-bold text-stone-400 font-mono"
                                        x-text="(activeSubIdx + 1) + ' / ' + activeModalModul.submodul.length"></span>

                                    <button @click="activeSubIdx = Math.min(activeModalModul.submodul.length - 1, activeSubIdx + 1)"
                                        :disabled="activeSubIdx === activeModalModul.submodul.length - 1"
                                        class="px-3.5 py-2 rounded-xl text-xs font-bold transition-all flex items-center gap-1.5"
                                        :class="activeSubIdx === activeModalModul.submodul.length - 1 ? 'bg-stone-100 text-stone-300 cursor-not-allowed' : 'bg-sipetran-green text-white hover:bg-emerald-900 shadow-sm'">
                                        <span>Selanjutnya</span>
                                        <i class="fa-solid fa-chevron-right text-[10px]"></i>
                                    </button>
                                </div>

                            </div>
                        </template>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- ============ FOOTER ============ -->
    <footer class="bg-[#FAF8F2] pt-12 pb-8 px-6 border-t border-stone-200 text-center text-xs text-gray-500">
        <p>&copy; {new Date().getFullYear()} SIPETRAN — Tim Pelaksana PPK ORMAWA Desa Gunungsari.</p>
    </footer>

</body>
</html>
