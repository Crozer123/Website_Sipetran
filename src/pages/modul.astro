const colorMap = {

    amber: { icon: 'text-amber-600', bg: 'bg-amber-100', badge: 'bg-amber-100 text-amber-800' },
    emerald: { icon: 'text-emerald-700', bg: 'bg-emerald-100', badge: 'bg-emerald-100 text-emerald-800' },
    teal: { icon: 'text-teal-700', bg: 'bg-teal-100', badge: 'bg-teal-100 text-teal-800' },
    green: { icon: 'text-green-700', bg: 'bg-green-100', badge: 'bg-green-100 text-green-800' }
};
---
<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Katalog Modul EDUSIP - SIPETRAN Desa Gunungsari</title>
    <meta name="description" content="Modul Edukasi Terpadu EDUSIP - Panduan Gizi SIJAGO, Kopi SILOKA, PHBS Posyandu, dan Biopori Lingkungan.">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,800;0,900;1,700&family=DM+Sans:opsz,wght@9..40,500;9..40,600;9..40,700;9..40,800&family=Inter:wght@400;500;600;700&family=Caveat:wght@700&display=swap" rel="stylesheet">

    <!-- Tailwind CSS -->
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script is:inline>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        display: ['Playfair Display', 'serif'],
                        heading: ['DM Sans', 'sans-serif'],
                        body: ['Inter', 'sans-serif'],
                        handwriting: ['Caveat', 'cursive'],
                    },
                    colors: {
                        sipetran: {
                            green: '#203816',
                            dark: '#14260d',
                            lightgreen: '#4a7c2f',
                            orange: '#d97706',
                            redorange: '#c85a32',
                            darkorange: '#b45309',
                            cream: '#FAF8F2',
                            bg: '#FAF8F2',
                        }
                    }
                }
            }
        }
    </script>

    <!-- Alpine.js -->
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <style>
        body { background-color: #FAF8F2; color: #1c2417; }

        .wave-separator {
            position: absolute;
            bottom: -2px;
            left: 0;
            width: 100%;
            overflow: hidden;
            line-height: 0;
        }

        @keyframes spin-slow {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
        .spin-slow { animation: spin-slow 18s linear infinite; }

        .ghia-badge-green {
            display: inline-block;
            background: #203816;
            color: #ffffff;
            border: 2.5px solid #FAF8F2;
            padding: 4px 18px;
            border-radius: 8px;
            transform: rotate(1.5deg);
            box-shadow: 0 4px 12px rgba(32, 56, 22, 0.25);
        }

        .modal-backdrop {
            background: rgba(20, 38, 13, 0.75);
            backdrop-filter: blur(8px);
        }
    </style>
</head>

<body class="font-body text-gray-800 antialiased" x-data="{ activeCat: 'all', activeModalModul: null }">

    <!-- ============ NAVIGATION ============ -->
    <header class="absolute top-0 left-0 right-0 z-50" x-data="{ mobileOpen: false }">
        <nav class="flex items-center justify-between py-5 px-6 max-w-6xl mx-auto">
            <a href="/" class="flex items-center gap-2.5 hover:opacity-80 transition-opacity">
                <span class="font-handwriting text-3.5xl text-emerald-300 font-bold tracking-wide">Sipetran</span>
                <span class="text-[10px] font-semibold text-green-300 tracking-widest uppercase border-l border-white/20 pl-2">Desa Gunungsari</span>
            </a>

            <div class="hidden md:flex items-center gap-7 font-body text-sm font-medium text-white/80">
                <a href="/" class="hover:text-white transition-colors">Beranda</a>
                <a href="/tentang" class="hover:text-white transition-colors">Tentang Program</a>
                <a href="/modul" class="text-white font-bold border-b-2 border-white pb-0.5">Program Modul</a>
                <a href="/admin" class="text-white/80 hover:text-white transition-colors flex items-center gap-1 font-medium bg-white/10 hover:bg-white/20 backdrop-blur-sm px-3.5 py-1.5 rounded-xl border border-white/20">
                    <i class="fa-solid fa-user-shield text-xs text-emerald-300"></i> Admin
                </a>
            </div>

            <button @click="mobileOpen = !mobileOpen" class="md:hidden p-2 text-white">
                <i class="fa-solid text-xl" :class="mobileOpen ? 'fa-xmark' : 'fa-bars'"></i>
            </button>
        </nav>
    </header>

    <!-- ============ HERO HEADER SECTION ============ -->
    <section class="relative bg-sipetran-green overflow-hidden pt-36 pb-32 text-center text-white">
        <div class="absolute inset-0 z-0">
            <img src="/images/hero_team.png" alt="PPK Ormawa Team" class="w-full h-full object-cover opacity-35 scale-105 filter brightness-110">
            <div class="absolute inset-0 bg-gradient-to-b from-sipetran-green/70 via-sipetran-green/60 to-sipetran-green/95"></div>
        </div>

        <div class="relative z-10 max-w-4xl mx-auto px-6">
            <span class="text-xs font-bold text-emerald-300 uppercase tracking-[0.3em] mb-4 inline-block">KATALOG 8 MODUL EDUSIP</span>

            <h1 class="font-display text-white text-5xl sm:text-6xl md:text-7xl font-black leading-tight tracking-tight">
                MODUL EDUKASI
                <br>
                <span class="ghia-badge-green font-black my-2">TERPADU DESA</span>
            </h1>

            <p class="mt-6 text-green-200 text-base md:text-lg max-w-2xl mx-auto leading-relaxed font-body">
                Panduan & modul pelaksanaan pemberdayaan masyarakat Desa Gunungsari yang terbagi dalam 8 fokus topik utama kesehatan, pangan, ekonomi, dan lingkungan.
            </p>
        </div>

        <div class="wave-separator">
            <svg viewBox="0 0 1440 100" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
                <path d="M0,50 C240,100 480,0 720,50 C960,100 1200,0 1440,100 L1440,100 L0,100 Z" fill="#FAF8F2"/>
            </svg>
        </div>
    </section>

    <!-- ============ FILTERABLE MODULE GRID SECTION ============ -->
    <section class="bg-[#FAF8F2] pt-16 pb-24 px-6">
        <div class="max-w-6xl mx-auto">
            <div class="flex justify-center gap-2 md:gap-3 mb-14 flex-wrap">
                <button @click="activeCat = 'all'"
                    :class="activeCat === 'all' ? 'bg-sipetran-green text-white shadow-lg scale-105 font-black' : 'bg-white text-gray-700 border border-stone-200 hover:bg-stone-50 font-semibold'"
                    class="text-xs md:text-sm px-6 py-3 rounded-full transition-all flex items-center gap-2">
                    <i class="fa-solid fa-border-all"></i> Semua Modul (8)
                </button>
                <button @click="activeCat = 'gizi'"
                    :class="activeCat === 'gizi' ? 'bg-emerald-700 text-white shadow-lg scale-105 font-black' : 'bg-white text-gray-700 border border-stone-200 hover:bg-stone-50 font-semibold'"
                    class="text-xs md:text-sm px-6 py-3 rounded-full transition-all flex items-center gap-2">
                    <i class="fa-solid fa-bowl-food"></i> Gizi & Pangan (2)
                </button>
                <button @click="activeCat = 'ekraf'"
                    :class="activeCat === 'ekraf' ? 'bg-teal-700 text-white shadow-lg scale-105 font-black' : 'bg-white text-gray-700 border border-stone-200 hover:bg-stone-50 font-semibold'"
                    class="text-xs md:text-sm px-6 py-3 rounded-full transition-all flex items-center gap-2">
                    <i class="fa-solid fa-mug-hot"></i> Ekonomi Kreatif (2)
                </button>
                <button @click="activeCat = 'kesehatan'"
                    :class="activeCat === 'kesehatan' ? 'bg-emerald-800 text-white shadow-lg scale-105 font-black' : 'bg-white text-gray-700 border border-stone-200 hover:bg-stone-50 font-semibold'"
                    class="text-xs md:text-sm px-6 py-3 rounded-full transition-all flex items-center gap-2">
                    <i class="fa-solid fa-heart-pulse"></i> Kesehatan (2)
                </button>
                <button @click="activeCat = 'lingkungan'"
                    :class="activeCat === 'lingkungan' ? 'bg-green-800 text-white shadow-lg scale-105 font-black' : 'bg-white text-gray-700 border border-stone-200 hover:bg-stone-50 font-semibold'"
                    class="text-xs md:text-sm px-6 py-3 rounded-full transition-all flex items-center gap-2">
                    <i class="fa-solid fa-seedling"></i> Lingkungan (2)
                </button>
            </div>

            <!-- Module Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                {modules.map((mod) => {
                    const c = colorMap[mod.catColor];
                    return (
                        <div x-show={`activeCat === 'all' || activeCat === '${mod.catKey}'`}
                            x-transition:enter="transition ease-out duration-300"
                            x-transition:enter-start="opacity-0 scale-90"
                            x-transition:enter-end="opacity-100 scale-100"
                            class="module-card bg-white rounded-[2.2rem] overflow-hidden shadow-sm border border-stone-200 flex flex-col hover:shadow-xl">
                            <div class="relative overflow-hidden" style="height: 170px;">
                                <img src={mod.img} alt={mod.title} class="w-full h-full object-cover" />
                                <span class="absolute top-3 right-3 text-[10px] font-black text-gray-800 bg-white/90 px-3 py-1 rounded-full backdrop-blur-sm shadow-xs uppercase tracking-wider">
                                    Modul {mod.num}
                                </span>
                            </div>

                            <div class="p-5 flex flex-col flex-1 gap-3">
                                <div class="flex items-center justify-between">
                                    <div class={`w-9 h-9 rounded-xl ${c.bg} ${c.icon} flex items-center justify-center shrink-0 border border-stone-100`}>
                                        <i class={`fa-solid ${mod.icon} text-sm`}></i>
                                    </div>
                                    <span class={`text-[10px] font-bold ${c.badge} px-2.5 py-0.5 rounded-full uppercase tracking-wider`}>{mod.cat}</span>
                                </div>
                                <div>
                                    <h3 class="font-display font-black text-gray-900 text-lg leading-tight mb-1">{mod.title}</h3>
                                    <p class="text-xs text-gray-500 leading-relaxed font-body line-clamp-3">{mod.desc}</p>
                                </div>
                                <div class="mt-auto pt-2">
                                    <button @click={`activeModalModul = ${JSON.stringify(mod)}`}
                                        class="w-full bg-stone-100 hover:bg-sipetran-green hover:text-white text-gray-700 font-bold text-xs py-2.5 px-4 rounded-xl transition-colors flex items-center justify-center gap-2">
                                        <span>Baca Modul Lengkap</span>
                                        <i class="fa-solid fa-arrow-right text-[10px]"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    );
                })}
            </div>
        </div>
    </section>

    <!-- ============ POPUP MODAL DETAIL READER ============ -->
    <div x-show="activeModalModul" x-transition.opacity
        class="fixed inset-0 z-[100] modal-backdrop flex items-center justify-center p-4"
        @click.self="activeModalModul = null" style="display:none;">

        <div class="bg-white rounded-[2.5rem] max-w-2xl w-full p-6 md:p-8 shadow-2xl border border-stone-100 relative overflow-y-auto max-h-[90vh] text-gray-800"
            x-show="activeModalModul"
            x-transition:enter="transition ease-out duration-300"
            x-transition:enter-start="opacity-0 scale-95 translate-y-4"
            x-transition:enter-end="opacity-100 scale-100 translate-y-0">

            <button @click="activeModalModul = null" class="sticky top-0 float-right w-9 h-9 rounded-full bg-stone-100 text-gray-500 hover:bg-stone-200 flex items-center justify-center transition-colors z-10">
                <i class="fa-solid fa-xmark text-sm"></i>
            </button>

            <template x-if="activeModalModul">
                <div class="space-y-5">
                    <!-- Header -->
                    <div class="space-y-2">
                        <span class="text-[10px] font-black uppercase tracking-widest text-emerald-800 bg-emerald-100 px-3 py-1 rounded-full" x-text="'Modul ' + activeModalModul.num"></span>
                        <h3 class="font-display font-black text-2xl md:text-3xl text-gray-900 leading-tight" x-text="activeModalModul.title"></h3>
                        <p class="text-xs text-gray-500 font-medium" x-text="activeModalModul.desc"></p>
                    </div>

                    <!-- Materi Detail -->
                    <div class="bg-stone-50 p-5 rounded-2xl border border-stone-200">
                        <h4 class="text-xs font-bold uppercase tracking-wider text-gray-700 mb-2 flex items-center gap-2">
                            <i class="fa-solid fa-book-open text-sipetran-green"></i> Materi & Informasi Detail
                        </h4>
                        <p class="text-xs text-gray-700 leading-relaxed font-body" x-text="activeModalModul.detail"></p>
                    </div>

                    <!-- Kegiatan Section -->
                    <template x-if="activeModalModul.kegiatan && activeModalModul.kegiatan.length > 0">
                        <div class="space-y-4">
                            <div class="flex items-center gap-2">
                                <div class="h-px flex-1 bg-stone-200"></div>
                                <span class="text-[10px] font-black uppercase tracking-widest text-sipetran-green flex items-center gap-1.5">
                                    <i class="fa-solid fa-camera"></i> Dokumentasi Kegiatan
                                </span>
                                <div class="h-px flex-1 bg-stone-200"></div>
                            </div>

                            <template x-for="(keg, kIdx) in activeModalModul.kegiatan" :key="kIdx">
                                <div class="bg-gradient-to-br from-emerald-50 to-stone-50 rounded-2xl border border-emerald-100 overflow-hidden">
                                    <!-- Kegiatan Header -->
                                    <div class="p-4 pb-2">
                                        <div class="flex items-start gap-3">
                                            <div class="w-9 h-9 rounded-xl bg-sipetran-green text-white flex flex-col items-center justify-center shrink-0 mt-0.5 shadow-sm">
                                                <i class="fa-solid text-xs" :class="keg.icon || 'fa-camera'"></i>
                                                <span class="text-[8px] font-black leading-none mt-0.5" x-text="'K.' + (keg.num || (kIdx+1))"></span>
                                            </div>
                                            <div>
                                                <span class="text-[9px] font-bold uppercase tracking-wider text-emerald-700" x-text="'Kegiatan ' + (keg.num || (kIdx+1))"></span>
                                                <h5 class="text-sm font-bold text-gray-900 leading-snug" x-text="keg.judul"></h5>
                                                <p class="text-xs text-gray-500 mt-1 leading-relaxed" x-text="keg.deskripsi"></p>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Photo Grid -->
                                    <template x-if="keg.foto && keg.foto.length > 0">
                                        <div class="px-4 pb-3">
                                            <div class="grid gap-1.5" :class="keg.foto.length === 1 ? 'grid-cols-1' : keg.foto.length === 2 ? 'grid-cols-2' : keg.foto.length === 3 ? 'grid-cols-3' : 'grid-cols-2'">
                                                <template x-for="(foto, fIdx) in keg.foto.slice(0, 4)" :key="fIdx">
                                                    <a :href="keg.driveLink" target="_blank" rel="noopener"
                                                        class="relative block overflow-hidden rounded-xl group cursor-pointer"
                                                        :style="keg.foto.length === 1 ? 'height:160px' : 'height:100px'">
                                                        <img :src="foto" :alt="keg.judul"
                                                            class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-110"
                                                            @error="$el.style.display='none'; $el.nextElementSibling.style.display='flex'"
                                                        />
                                                        <!-- Fallback jika foto gagal load -->
                                                        <div class="w-full h-full bg-stone-200 items-center justify-center flex-col gap-1 text-stone-400" style="display:none">
                                                            <i class="fa-solid fa-image text-xl"></i>
                                                            <span class="text-[9px] font-medium">Lihat di Drive</span>
                                                        </div>
                                                        <!-- Overlay -->
                                                        <div class="absolute inset-0 bg-sipetran-green/0 group-hover:bg-sipetran-green/30 transition-all flex items-center justify-center">
                                                            <i class="fa-solid fa-magnifying-glass text-white opacity-0 group-hover:opacity-100 transition-opacity text-sm"></i>
                                                        </div>
                                                        <!-- Badge jumlah sisa foto di tile ke-4 jika > 4 -->
                                                        <template x-if="fIdx === 3 && keg.foto.length > 4">
                                                            <div class="absolute inset-0 bg-black/50 flex items-center justify-center">
                                                                <span class="text-white font-black text-lg" x-text="'+' + (keg.foto.length - 4)"></span>
                                                            </div>
                                                        </template>
                                                    </a>
                                                </template>
                                            </div>
                                        </div>
                                    </template>

                                    <!-- Drive Link -->
                                    <div class="px-4 pb-4">
                                        <a :href="keg.driveLink" target="_blank" rel="noopener"
                                            class="inline-flex items-center gap-2 text-[10px] font-bold text-emerald-700 hover:text-emerald-900 bg-white border border-emerald-200 hover:border-emerald-400 px-3 py-1.5 rounded-lg transition-all">
                                            <i class="fa-brands fa-google-drive text-sm"></i>
                                            Lihat Semua Foto di Google Drive
                                            <i class="fa-solid fa-arrow-up-right-from-square text-[9px]"></i>
                                        </a>
                                    </div>
                                </div>
                            </template>
                        </div>
                    </template>
                </div>
            </template>
        </div>
    </div>

    <!-- ============ FOOTER ============ -->
    <footer class="bg-[#FAF8F2] pt-12 pb-8 px-6 border-t border-stone-200 text-center text-xs text-gray-500">
        <p>&copy; {new Date().getFullYear()} SIPETRAN — Tim Pelaksana PPK ORMAWA Desa Gunungsari.</p>
    </footer>

</body>
</html>
