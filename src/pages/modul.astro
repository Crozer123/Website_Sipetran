                icon: 'fa-seedling',
                driveLink: 'https://drive.google.com/drive/folders/17bF6vdEX947vZnX1-RvoEvrIcKg2LPJI'
            },
            {
                num: 9,
                judul: 'Rapat Koordinasi Pelatihan Kelompok Divisi Lingkungan',
                deskripsi: 'Rapat koordinasi pelatihan dan pendampingan kelompok divisi program SIPETRAN bidang lingkungan, membahas teknis pembuatan biopori dan sistem pemilahan sampah 4 jenis.',
                icon: 'fa-comments',
                driveLink: 'https://drive.google.com/drive/folders/17bF6vdEX947vZnX1-RvoEvrIcKg2LPJI'
            }
        ]
    },
    {
        num: '08', icon: 'fa-fire', title: 'Incinerator Drum', catKey: 'lingkungan', cat: 'Lingkungan', catColor: 'green',
        img: '/images/biopori_eco.png',
