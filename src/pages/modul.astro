        this.activeModalModul = mod;
        this.activeSubIdx = 0;
        this.activeTab = 'content';
        this.isFullscreen = false;
        document.body.style.overflow = 'hidden';
    },
    closeReader() {
        this.activeModalModul = null;
        document.body.style.overflow = 'auto';
    }
}">

    <!-- ============ NAVIGATION ============ -->
