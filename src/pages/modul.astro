                driveLink: 'https://drive.google.com/drive/folders/17bF6vdEX947vZnX1-RvoEvrIcKg2LPJI'
            }
        ]
    },
    {
        num: '06', icon: 'fa-hands-bubbles', title: 'Cuci Tangan & Oralit', catKey: 'kesehatan', cat: 'Kesehatan', catColor: 'teal',
        img: '/images/posyandu_health.png',
        desc: '6 langkah cuci tangan WHO & panduan larutan oralit darurat untuk pencegahan diare.',
