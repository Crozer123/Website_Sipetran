---
<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tentang Program - SIPETRAN Desa Gunungsari</title>
    <meta name="description" content="Profil lengkap Program PPK ORMAWA SIPETRAN Desa Gunungsari Bondowoso - HIMA Gizi FKM Universitas Jember.">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,800;0,900;1,700&family=DM+Sans:opsz,wght@9..40,500;9..40,600;9..40,700;9..40,800&family=Inter:wght@400;500;600;700&family=Caveat:wght@700&display=swap" rel="stylesheet">

    <!-- Tailwind CSS -->
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script is:inline>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        display: ['Playfair Display', 'serif'],
                        heading: ['DM Sans', 'sans-serif'],
                        body: ['Inter', 'sans-serif'],
                        handwriting: ['Caveat', 'cursive'],
                    },
                    colors: {
                        sipetran: {
                            green: '#203816',
                            dark: '#14260d',
                            lightgreen: '#4a7c2f',
                            orange: '#d97706',
                            redorange: '#c85a32',
                            darkorange: '#b45309',
                            cream: '#FAF8F2',
                            bg: '#FAF8F2',
                        }
                    }
                }
            }
        }
    </script>

    <!-- Alpine.js -->
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <style>
        body { background-color: #FAF8F2; color: #1c2417; }

        .wave-separator {
            bottom: -2px;
            left: 0;
            width: 100%;
            overflow: hidden;
            line-height: 0;
        }

        .ghia-badge-green {
            display: inline-block;
            background: #203816;
            color: #ffffff;
            border: 2.5px solid #FAF8F2;
            padding: 4px 18px;
            border-radius: 8px;
            transform: rotate(1.5deg);
            box-shadow: 0 4px 12px rgba(32, 56, 22, 0.25);
        }

        .feature-card { transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.35s ease; }
        .feature-card:hover { transform: translateY(-6px); box-shadow: 0 20px 40px rgba(0,0,0,0.08); }
    </style>
</head>

<body class="font-body text-gray-800 antialiased">

    <!-- ============ NAVIGATION ============ -->
    <header class="absolute top-0 left-0 right-0 z-50" x-data="{ mobileOpen: false }">
        <nav class="flex items-center justify-between py-5 px-6 max-w-6xl mx-auto">
            <!-- Logo -->
            <a href="/" class="flex items-center gap-2.5 hover:opacity-80 transition-opacity">
                <span class="font-handwriting text-3xl text-emerald-300 font-bold tracking-wide">Sipetran</span>
                <span class="text-[10px] font-semibold text-green-300 tracking-widest uppercase border-l border-white/20 pl-2">Desa Gunungsari</span>
            </a>

            <!-- Desktop Nav Links -->
            <div class="hidden md:flex items-center gap-7 font-body text-sm font-medium text-white/80">
                <a href="/" class="hover:text-white transition-colors">Beranda</a>
                <a href="/tentang" class="text-white font-bold border-b-2 border-white pb-0.5">Tentang Program</a>

                <!-- Dropdown Mitra -->
                <div class="relative" x-data="{ open: false }" @click.outside="open = false">
                    <button @click="open = !open" class="hover:text-white transition-colors flex items-center gap-1.5 focus:outline-none">
                        <span>Mitra</span>
                        <i class="fa-solid fa-chevron-down text-[10px] transition-transform duration-200" :class="open ? 'rotate-180 text-emerald-300' : 'text-white/50'"></i>
                    </button>

                    <!-- Dropdown Card -->
                    <div x-show="open" x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0 translate-y-2 scale-95" x-transition:enter-end="opacity-100 translate-y-0 scale-100" class="absolute left-1/2 -translate-x-1/2 mt-3 w-72 bg-white rounded-3xl shadow-xl border border-stone-100 p-4 z-50 text-gray-800">
                        <p class="text-[10px] font-bold uppercase tracking-wider text-gray-400 mb-3 px-2">Mitra Kolaborasi Program</p>
                        <div class="space-y-1 text-xs font-semibold">
                            <div class="p-2 rounded-xl bg-emerald-50 text-emerald-900">Kecamatan Maesan & Pemdes</div>
                            <div class="p-2 rounded-xl bg-emerald-50 text-emerald-900">Perhutani Bondowoso</div>
                            <div class="p-2 rounded-xl bg-emerald-50 text-emerald-900">BPBD Kabupaten Bondowoso</div>
                            <div class="p-2 rounded-xl bg-emerald-50 text-emerald-900">Puskesmas & PKK Maesan</div>
                        </div>
                    </div>
                </div>

                <a href="/modul" class="hover:text-white transition-colors">Program Modul</a>
                <a href="/kegiatan" class="hover:text-white transition-colors">Kegiatan</a>
            </div>

            <!-- Mobile Hamburger -->
            <button @click="mobileOpen = !mobileOpen" class="md:hidden p-2 text-white">
                <i class="fa-solid text-xl" :class="mobileOpen ? 'fa-xmark' : 'fa-bars'"></i>
            </button>
        </nav>

        <!-- Mobile Menu Drawer -->
        <div x-show="mobileOpen" x-transition class="fixed top-4 left-4 right-4 bg-white rounded-[2rem] shadow-2xl z-50 px-6 py-4 border border-gray-100 md:hidden text-gray-800">
            <div class="flex flex-col gap-0">
                <a href="/" @click="mobileOpen=false" class="py-3 border-b border-gray-100 text-sm text-gray-700 font-medium">Beranda</a>
                <a href="/tentang" @click="mobileOpen=false" class="py-3 border-b border-gray-100 text-sm text-sipetran-green font-bold">Tentang Program</a>
                <a href="/modul" @click="mobileOpen=false" class="py-3 border-b border-gray-100 text-sm text-gray-700 font-medium">Program Modul</a>
                <a href="/kegiatan" @click="mobileOpen=false" class="py-3 text-sm text-gray-700 font-medium">Kegiatan</a>
            </div>
        </div>
    </header>

    <!-- ============ HERO HEADER ============ -->
    <section class="relative bg-sipetran-green overflow-hidden pt-36 pb-36 text-center">
        <div class="absolute inset-0 z-0">
            <img src="/images/hero_team.png" alt="PPK Ormawa Team" class="w-full h-full object-cover opacity-35 scale-105 filter brightness-110">
            <div class="absolute inset-0 bg-gradient-to-b from-sipetran-green/80 via-sipetran-green/70 to-sipetran-green"></div>
        </div>

        <div class="relative z-10 max-w-4xl mx-auto px-6">
            <h1 class="font-display text-white text-3xl sm:text-5xl md:text-6xl font-black leading-tight tracking-tight">
                SIPETRAN
                <br>
                <span class="text-emerald-300 text-xl sm:text-3xl font-semibold my-2 block">Sistem Pemberdayaan Terpadu Desa Hutan Berkelanjutan</span>
            </h1>

            <p class="mt-4 text-green-100/90 text-sm md:text-base max-w-3xl mx-auto leading-relaxed font-body">
                Integrasi Konservasi Lahan dan Pengelolaan Sampah Berbasis Teknologi Menuju Kemandirian Pangan Desa Gunungsari, Kecamatan Maesan, Kabupaten Bondowoso.
            </p>
        </div>

        <div class="wave-separator absolute bottom-0">
            <svg viewBox="0 0 1440 80" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
                <path d="M0,40 C240,80 480,0 720,40 C960,80 1200,0 1440,40 L1440,80 L0,80 Z" fill="#FAF8F2"/>
            </svg>
        </div>
    </section>

    <!-- ============ RINGKASAN & GAMBARAN DESA BINAAN ============ -->
    <section class="py-20 px-6 max-w-6xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
            <div class="space-y-5">
                <span class="text-xs font-bold uppercase tracking-widest text-emerald-700 bg-emerald-100 px-3.5 py-1 rounded-full border border-emerald-200">PROFIL DESA BINAAN</span>
                <h2 class="font-display font-black text-3xl md:text-4xl text-gray-900 leading-tight">
                    Desa Gunungsari, Argopuro Bondowoso
                </h2>
                <p class="text-gray-600 text-sm leading-relaxed font-body">
                    Desa Gunungsari merupakan Desa Binaan Universitas Jember (SK Rektor No. 32371/UN25/TU/2025) yang terletak di lereng Gunung Argopuro, Kecamatan Maesan, Kabupaten Bondowoso. Berada di ketinggian 444 mdpl dengan luas wilayah 3,564 km² dan dihuni oleh 4.077 jiwa (8 Dusun).
                </p>
                <p class="text-gray-600 text-sm leading-relaxed font-body">
                    Mayoritas penduduk (52,45%) bermata pencaharian di sektor pertanian dengan komoditas unggulan kopi robusta (30 ton/tahun), jagung (13 ton/tahun), dan padi. Program SIPETRAN hadir mengoptimalkan potensi lokal serta menjawab tantangan lingkungan, kesehatan, dan ekonomi.
                </p>
            </div>

            <!-- Stats Grid -->
            <div class="grid grid-cols-2 gap-4">
                <div class="bg-white p-6 rounded-3xl border border-stone-200 shadow-sm text-center feature-card">
                    <div class="w-12 h-12 rounded-2xl bg-emerald-100 flex items-center justify-center mx-auto mb-3 p-2">
                        <img src="/images/cat_kebun_gizi.png" alt="Lahan Hutan" class="w-full h-full object-contain" />
                    </div>
                    <span class="font-display font-black text-3xl text-gray-900 block">57 Ha</span>
                    <span class="text-xs text-gray-500 font-medium">Luas Lahan Hutan</span>
                </div>
                <div class="bg-white p-6 rounded-3xl border border-stone-200 shadow-sm text-center feature-card">
                    <div class="w-12 h-12 rounded-2xl bg-amber-100 flex items-center justify-center mx-auto mb-3 p-2">
                        <img src="/images/cat_siloka.png" alt="Panen Kopi" class="w-full h-full object-contain" />
                    </div>
                    <span class="font-display font-black text-3xl text-gray-900 block">30 Ton</span>
                    <span class="text-xs text-gray-500 font-medium">Panen Kopi / Tahun</span>
                </div>
                <div class="bg-white p-6 rounded-3xl border border-stone-200 shadow-sm text-center feature-card">
                    <div class="w-12 h-12 rounded-2xl bg-teal-100 flex items-center justify-center mx-auto mb-3 p-2">
                        <img src="/images/cat_nugget.png" alt="Hasil Jagung" class="w-full h-full object-contain" />
                    </div>
                    <span class="font-display font-black text-3xl text-gray-900 block">13 Ton</span>
                    <span class="text-xs text-gray-500 font-medium">Hasil Jagung / Tahun</span>
                </div>
                <div class="bg-white p-6 rounded-3xl border border-stone-200 shadow-sm text-center feature-card">
                    <div class="w-12 h-12 rounded-2xl bg-blue-100 text-blue-800 flex items-center justify-center mx-auto mb-3 text-xl font-bold">
                        <i class="fa-solid fa-users"></i>
                    </div>
                    <span class="font-display font-black text-3xl text-gray-900 block">8 Dusun</span>
                    <span class="text-xs text-gray-500 font-medium">Wilayah Sasaran</span>
                </div>
            </div>
        </div>
    </section>

    <!-- ============ 4 PROGRAM UTAMA SIPETRAN ============ -->
    <section class="py-20 px-6 bg-white border-y border-stone-200">
        <div class="max-w-6xl mx-auto">
            <div class="text-center max-w-3xl mx-auto mb-14">
                <h2 class="font-display font-black text-3xl md:text-4xl text-gray-900">
                    4 Program Utama SIPETRAN
                </h2>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                <!-- Pilar 1 -->
                <div class="bg-[#FAF8F2] p-6 rounded-3xl border border-stone-200 space-y-3 flex flex-col justify-between">
                    <div>
                        <div class="w-10 h-10 rounded-xl bg-amber-500 text-white flex items-center justify-center mb-4">
                            <i class="fa-solid fa-bowl-food text-lg"></i>
                        </div>
                        <h3 class="font-display font-bold text-lg text-gray-900">Ekonomi Kreatif & Pangan</h3>
                        <p class="text-xs text-gray-600 leading-relaxed font-body mt-2">
                            Pengembangan olahan lokal bernilai tambah tinggi: Nugget SIJAGO (Jagung, Kelor) & Kopi SILOKA (Kopi Rempah Jahe Sereh).
                        </p>
                    </div>
                </div>

                <!-- Pilar 2 -->
                <div class="bg-[#FAF8F2] p-6 rounded-3xl border border-stone-200 space-y-3 flex flex-col justify-between">
                    <div>
                        <div class="w-10 h-10 rounded-xl bg-teal-600 text-white flex items-center justify-center mb-4">
                            <i class="fa-solid fa-heart-pulse text-lg"></i>
                        </div>
                        <h3 class="font-display font-bold text-lg text-gray-900">Kesehatan & PHBS</h3>
                        <p class="text-xs text-gray-600 leading-relaxed font-body mt-2">
                            Pencegahan stunting, Anemia & KEK ibu hamil melalui PMT pangan lokal serta sosialisasi 10 indikator PHBS rumah tangga.
                        </p>
                    </div>
                </div>

                <!-- Pilar 3 -->
                <div class="bg-[#FAF8F2] p-6 rounded-3xl border border-stone-200 space-y-3 flex flex-col justify-between">
                    <div>
                        <div class="w-10 h-10 rounded-xl bg-emerald-700 text-white flex items-center justify-center mb-4">
                            <i class="fa-solid fa-seedling text-lg"></i>
                        </div>
                        <h3 class="font-display font-bold text-lg text-gray-900">Konservasi & Lingkungan</h3>
                        <p class="text-xs text-gray-600 leading-relaxed font-body mt-2">
                            Pembuatan resapan air biopori, pembakar sampah minim polusi, pengolahan kompos EM4 kotoran ternak, dan reboisasi.
                        </p>
                    </div>
                </div>

                <!-- Pilar 4 -->
                <div class="bg-[#FAF8F2] p-6 rounded-3xl border border-stone-200 space-y-3 flex flex-col justify-between">
                    <div>
                        <div class="w-10 h-10 rounded-xl bg-blue-600 text-white flex items-center justify-center mb-4">
                            <i class="fa-solid fa-mobile-screen-button text-lg"></i>
                        </div>
                        <h3 class="font-display font-bold text-lg text-gray-900">Aplikasi Digital SIPETRAN</h3>
                        <p class="text-xs text-gray-600 leading-relaxed font-body mt-2">
                            Platform Android terpadu sebagai pusat edukasi, panduan resep, pemantauan kegiatan, serta media pemasaran produk digital.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ============ TIM PELAKSANA PPK ORMAWA HIMA GIZI ============ -->
    <section class="py-20 px-6 max-w-6xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-14">
            <h2 class="font-display font-black text-3xl md:text-4xl text-gray-900 mb-2">
                Struktur Tim Pelaksana PPK ORMAWA 2026
            </h2>
            <p class="text-xs md:text-sm text-gray-500 font-body">
                Himpunan Mahasiswa Gizi (HIMA Gizi) Fakultas Kesehatan Masyarakat Universitas Jember
            </p>
        </div>

        <!-- Hierarchical Team Layout -->
        <div class="space-y-6 max-w-4xl mx-auto">
            <!-- Level 1: Dosen Pendamping -->
            <div class="bg-white p-6 rounded-3xl border border-stone-200 shadow-sm text-center max-w-xl mx-auto">
                <span class="text-[10px] font-bold uppercase tracking-widest text-stone-500 block mb-1">Dosen Pendamping Program</span>
                <h3 class="font-display font-bold text-xl text-gray-900">Septi Nur Rachmawati, S.Gz., M.Gz</h3>
            </div>

            <!-- Vertical Connector Line -->
            <div class="w-0.5 h-6 bg-stone-300 mx-auto"></div>

            <!-- Level 2: Ketua Tim -->
            <div class="bg-white p-6 rounded-3xl border border-stone-300 shadow-sm text-center max-w-xl mx-auto">
                <span class="text-[10px] font-bold uppercase tracking-widest text-stone-500 block mb-1">Ketua Tim Pelaksana</span>
                <h3 class="font-display font-bold text-xl text-gray-900">Oktavia Rahma Ramadhani</h3>
            </div>

            <!-- Vertical Connector Line -->
            <div class="w-0.5 h-6 bg-stone-300 mx-auto"></div>

            <!-- Level 3: Sekretaris & Bendahara Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-3xl mx-auto">
                <div class="bg-white p-5 rounded-2xl border border-stone-200 text-center">
                    <span class="text-[10px] font-bold uppercase tracking-widest text-stone-500 block mb-1">Sekretaris Tim</span>
                    <h4 class="font-bold text-gray-900 text-sm">Del Viera Alphi Nur Syahara</h4>
                    <p class="text-xs text-gray-500 mt-0.5">Nabila Nuraini Eka Putri</p>
                </div>
                <div class="bg-white p-5 rounded-2xl border border-stone-200 text-center">
                    <span class="text-[10px] font-bold uppercase tracking-widest text-stone-500 block mb-1">Bendahara Tim</span>
                    <h4 class="font-bold text-gray-900 text-sm">Septiya Nariswari</h4>
                    <p class="text-xs text-gray-500 mt-0.5">Chelsea Tiara Gontha</p>
                </div>
            </div>

            <!-- Vertical Connector Line -->
            <div class="w-0.5 h-6 bg-stone-300 mx-auto"></div>

            <!-- Level 4: Divisi / Departemen Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                <div class="bg-white p-5 rounded-2xl border border-stone-200 text-center space-y-1">
                    <span class="text-[10px] font-bold uppercase tracking-widest text-stone-500 block">Departemen Kesehatan & Gizi</span>
                    <h4 class="font-bold text-gray-900 text-sm">Rumaisya 'Aatikah Ruskaya</h4>
                    <p class="text-xs text-gray-500 leading-relaxed">Sefia Aura Agustin<br>Erwina Dwi Yustiningsih</p>
                </div>
                <div class="bg-white p-5 rounded-2xl border border-stone-200 text-center space-y-1">
                    <span class="text-[10px] font-bold uppercase tracking-widest text-stone-500 block">Departemen Ekonomi Kreatif</span>
                    <h4 class="font-bold text-gray-900 text-sm">Dini Permata Sari</h4>
                    <p class="text-xs text-gray-500 leading-relaxed">Achmad Ilham Fauzi</p>
                </div>
                <div class="bg-white p-5 rounded-2xl border border-stone-200 text-center space-y-1">
                    <span class="text-[10px] font-bold uppercase tracking-widest text-stone-500 block">Departemen Lingkungan</span>
                    <h4 class="font-bold text-gray-900 text-sm">Faizah Rahma Sujana</h4>
                    <p class="text-xs text-gray-500 leading-relaxed">Imelda Khoirunnisa<br>Jesica Febriola<br>Lintang Wulan Rika Effendi</p>
                </div>
                <div class="bg-white p-5 rounded-2xl border border-stone-200 text-center space-y-1">
                    <span class="text-[10px] font-bold uppercase tracking-widest text-stone-500 block">Departemen Media & Informasi</span>
                    <h4 class="font-bold text-gray-900 text-sm">Gyzna Luzetta Kaylani</h4>
                    <p class="text-xs text-gray-500 leading-relaxed">Sefia Aura Agustin<br>Imelda Khoirunnisa<br>Achmad Ilham Fauzi<br>Lintang Wulan Rika Effendi</p>
                </div>
            </div>
        </div>
    </section>

    <!-- ============ CALLOUT BANNER (Curved Wave Dividers) ============ -->
    <section class="bg-sipetran-green text-white py-24 px-6 relative overflow-hidden text-center">
        <!-- Top Wave Divider -->
        <div class="absolute top-0 left-0 right-0 overflow-hidden leading-none z-10" style="transform: rotate(180deg);">
            <svg viewBox="0 0 1440 60" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none" class="w-full h-10 md:h-14">
                <path d="M0,30 C360,60 720,0 1080,45 C1260,60 1380,20 1440,30 L1440,60 L0,60 Z" fill="#FAF8F2"/>
            </svg>
        </div>

        <div class="max-w-4xl mx-auto py-4 relative z-10">
            <span class="inline-block bg-white/10 text-emerald-300 font-semibold px-4 py-1.5 rounded-full text-xs border border-white/20 mb-4">Pengabdian PPK ORMAWA 2026</span>
            <h2 class="font-display text-3xl md:text-5xl font-black text-white leading-tight mb-4">
                Membangun Desa Binaan Mandiri, Sehat, dan Berkelanjutan
            </h2>
            <p class="text-green-100/90 text-xs md:text-sm leading-relaxed max-w-2xl mx-auto mb-8 font-body">
                Apresiasi setinggi-tingginya kepada seluruh warga Desa Gunungsari, kader posyandu, perangkat desa, serta pihak Universitas Jember yang mensukseskan program SIPETRAN.
            </p>

            <a href="/modul" class="inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-xs md:text-sm px-7 py-3.5 rounded-xl transition-all shadow-md hover:scale-105">
                Buka 8 Modul Program
                <i class="fa-solid fa-arrow-right text-xs"></i>
            </a>
        </div>

        <!-- Bottom Wave Divider -->
        <div class="absolute bottom-0 left-0 right-0 overflow-hidden leading-none z-10">
            <svg viewBox="0 0 1440 60" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none" class="w-full h-10 md:h-14">
                <path d="M0,30 C360,60 720,0 1080,45 C1260,60 1380,20 1440,30 L1440,60 L0,60 Z" fill="#FAF8F2"/>
            </svg>
        </div>
    </section>

    <!-- ============ ULTRA FOOTER ============ -->
    <footer class="bg-[#FAF8F2] pt-16 pb-10 px-8 relative overflow-hidden border-t border-stone-200">
        <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-10">
            <div class="md:col-span-1">
                <a href="/" class="inline-block mb-3">
                    <span class="font-handwriting text-4xl text-sipetran-green font-bold">Sipetran</span>
                </a>
                <p class="text-gray-600 text-xs leading-relaxed max-w-xs mb-3 font-body">
                    Sistem Pemberdayaan Terpadu Desa Hutan Berkelanjutan Desa Gunungsari, Kec. Maesan, Kab. Bondowoso.
                </p>
                <span class="inline-block text-[10px] font-bold uppercase tracking-wider bg-sipetran-green/10 px-3 py-1 rounded-full text-sipetran-green">
                    PPK ORMAWA UNEJ 2026
                </span>
            </div>

            <div>
                <h4 class="font-display font-bold text-gray-900 text-sm mb-4">NAVIGASI</h4>
                <ul class="space-y-2 text-xs text-gray-600 font-body">
                    <li><a href="/" class="hover:text-sipetran-green font-medium">Beranda</a></li>
                    <li><a href="/tentang" class="hover:text-sipetran-green font-medium">Tentang Program</a></li>
                    <li><a href="/modul" class="hover:text-sipetran-green font-medium">Program Modul</a></li>
                    <li><a href="/kegiatan" class="hover:text-sipetran-green font-medium">Dokumentasi Kegiatan</a></li>
                </ul>
