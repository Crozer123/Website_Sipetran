        tanggal: '18 Juni 2026',
        lokasi: 'Balai Desa Gunungsari',
        tag: 'Sosialisasi',
        tagColor: 'purple',
        fotos: [
            '/images/kegiatan/keg_2_1.png',
            '/images/kegiatan/keg_2_2.png',
