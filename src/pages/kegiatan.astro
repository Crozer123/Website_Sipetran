        tanggal: '15 Juni 2026',
        lokasi: 'Balai Desa Gunungsari',
        tag: 'Koordinasi',
        tagColor: 'blue',
        fotos: [
            '/images/kegiatan/keg_1_1.png',
            '/images/kegiatan/keg_1_2.png',
            '/images/kegiatan/keg_1_3.png',
            '/images/kegiatan/keg_1_4.png',
            '/images/kegiatan/keg_1_5.png'
        ]
    },
    {
